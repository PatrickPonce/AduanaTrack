# Copiar a .env (ignorado por git) y reemplazar los valores. Nunca subir .env al repositorio.
POSTGRES_DB=aduanatrack
POSTGRES_USER=aduanatrack
POSTGRES_PASSWORD=cambiar-por-una-clave-local
# Al menos 32 caracteres aleatorios, p. ej.: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# true solo si el sistema se sirve por HTTPS
COOKIE_SECURE=false
