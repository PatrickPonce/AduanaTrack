# Plantilla: la imagen de nginx sustituye ${BACKEND_URL} al arrancar (por defecto http://backend:8080 en Docker Compose;
# en Render es la URL pública del backend). Las demás variables propias de nginx no se tocan.

# Si hay un proxy HTTPS delante (Render), se conserva su protocolo; si no, el del propio nginx.
map $http_x_forwarded_proto $proto_cliente {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # La carta poder admite hasta 10 MB (nginx corta en 1 MB por defecto).
    client_max_body_size 11m;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        # Host del backend (Render enruta por nombre de host).
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proto_cliente;
    }

    # Los archivos de /assets llevan el hash en el nombre: se cachean un año. Si no existe (p. ej. una pestaña abierta con
    # una versión anterior) responde 404 y no el index.html, para que el navegador no lo confunda con un módulo JavaScript.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # El index.html nunca se guarda en caché: cada despliegue cambia los nombres de los archivos que referencia.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA: las rutas de React Router (/dashboard, /clientes/...) devuelven index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
